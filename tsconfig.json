{
  "extends": "plasmo/templates/tsconfig.base",
  
  "exclude": ["node_modules"],
  "include": [
    ".plasmo/index.d.ts",
    "./**/*.ts",
    "./**/*.tsx",
    "postcss.config.js",
  ],
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "paths": {
      "~*": ["./src/*"],
      "@/*": ["./*"],
    },
  },
}
